# 로컬 환경 변수 예시
# 사용법: cp .env.example .env  후 값을 채우세요.
# .env 파일은 절대 커밋하지 않습니다.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=subflow
DB_TEST_NAME=subflow_test
DB_USERNAME=subflow
DB_PASSWORD=subflow

SERVER_PORT=8080

# Google OAuth2 (운영 배포 시에만 필요)
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
# 승인된 리디렉션 URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
