# 로컬 환경 변수 예시
# 사용법: cp .env.example .env  후 값을 채우세요.
# .env 파일은 절대 커밋하지 않습니다.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=subflow
DB_TEST_NAME=subflow_test
DB_USERNAME=subflow
DB_PASSWORD=subflow

SERVER_PORT=8080

# 운영 Compose(compose.prod.yml)에서 호스트 loopback에 매핑할 포트
APP_PORT=19007

# 감사 로그 해시 pepper (운영 필수, 실제 값은 커밋하지 않음)
# change-me-in-production 은 예시값이며, 그대로 사용하면 운영 기동에 실패합니다.
AUDIT_HASH_PEPPER=change-me-in-production

# Google OAuth2 (운영 배포 시에만 필요)
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
# 승인된 리디렉션 URI(로컬): http://localhost:8080/login/oauth2/code/google
# 승인된 리디렉션 URI(운영): https://subflow.stda.app/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
