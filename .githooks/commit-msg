#!/bin/sh
#
# Conventional Commits 형식을 검사하는 commit-msg 훅입니다.
# 설치: git config core.hooksPath .githooks
#
# 허용 형식:
#   <type>: <설명>
#   <type>(<scope>): <설명>
#
# 예외: merge, revert, fixup!, squash! 커밋은 검사하지 않습니다.

msg_file="$1"

if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    echo "commit-msg: 커밋 메시지 파일을 찾을 수 없습니다." >&2
    exit 1
fi

# 주석과 빈 줄을 제외한 첫 줄을 제목으로 사용
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)

# 빈 메시지 차단
if [ -z "$subject" ]; then
    echo "commit-msg: 커밋 메시지가 비어 있습니다." >&2
    exit 1
fi

# 예외 커밋은 통과
case "$subject" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *)
        exit 0
        ;;
esac

types="feat|fix|docs|style|refactor|test|chore|perf|build|ci|revert"

if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-zA-Z0-9._/-]+\))?: .+"; then
    echo "" >&2
    echo "커밋 메시지가 컨벤션을 따르지 않습니다." >&2
    echo "" >&2
    echo "  지금: $subject" >&2
    echo "  형식: <type>: <설명>" >&2
    echo "" >&2
    echo "  type: feat | fix | docs | style | refactor | test | chore | perf | build | ci | revert" >&2
    echo "" >&2
    echo "  예시:" >&2
    echo "    feat: 구독 목록 조회 API 추가" >&2
    echo "    fix: 로그인 후 리다이렉트 경로 수정" >&2
    echo "    refactor(subscription): 중복 검증 로직 제거" >&2
    echo "" >&2
    exit 1
fi

# 마침표로 끝나는 제목 차단
case "$subject" in
    *.)
        echo "commit-msg: 제목 끝에 마침표를 붙이지 마세요." >&2
        echo "  지금: $subject" >&2
        exit 1
        ;;
esac

# 제목 길이 권장 (50자 초과 시 경고만)
len=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$len" -gt 50 ]; then
    echo "commit-msg: 경고 — 제목이 ${len}자입니다. 50자 이내를 권장합니다." >&2
fi

exit 0
