<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <meta name="_csrf" content="{{_csrf.token}}">
    <meta name="_csrf_header" content="{{_csrf.headerName}}">
    <title>SubFlow - 구독 관리</title>

    <link rel="stylesheet" href="/vendor/pretendard/pretendardvariable.css">
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/app.css?v=20261125r">
    <script src="/vendor/chartjs/chart.umd.min.js"></script>
</head>
<body>

<h1 class="visually-hidden">SubFlow 구독 통합 관리</h1>

<!-- 토스트 알림 -->
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="liveToast" class="toast align-items-center text-bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">알림 내용</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="알림 닫기"></button>
        </div>
    </div>
</div>

<!-- 상단 내비게이션 -->
<header class="sf-top">
    <div class="sf-top-inner">
        <a class="sf-logo" href="/">SubFlow</a>

        <nav class="sf-tabs" id="viewTabs" role="tablist" aria-label="화면 전환">
            <button class="sf-tab active" id="tab-cal-btn" type="button" role="tab"
                    data-bs-toggle="pill" data-bs-target="#tab-calendar" aria-controls="tab-calendar"
                    aria-selected="true" data-action="load-calendar">캘린더</button>
            <button class="sf-tab" id="tab-list-btn" type="button" role="tab"
                    data-bs-toggle="pill" data-bs-target="#tab-list" aria-controls="tab-list"
                    aria-selected="false">구독</button>
            <button class="sf-tab" id="tab-charts-btn" type="button" role="tab"
                    data-bs-toggle="pill" data-bs-target="#tab-charts" aria-controls="tab-charts"
                    aria-selected="false" data-action="render-charts">분석</button>
            <button class="sf-tab" id="tab-shares-btn" type="button" role="tab"
                    data-bs-toggle="pill" data-bs-target="#tab-shares" aria-controls="tab-shares"
                    aria-selected="false" data-action="load-shares">공유</button>
        </nav>

        <div class="sf-top-actions">
            <span class="sf-today" id="todayLabel"></span>
            <a class="sf-btn sf-btn-ghost" href="/settings">설정</a>
            <button type="button" class="sf-btn sf-btn-ghost" data-bs-toggle="modal" data-bs-target="#importModal">
                <i class="bi bi-upload"></i>내역 가져오기
            </button>
            <button type="button" class="sf-btn sf-btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg"></i>새 구독
            </button>
        </div>
    </div>
</header>

<main class="sf-main">

    <!-- 요약 지표 -->
    <section class="sf-kpis" aria-label="구독 요약">
        <div class="sf-kpi">
            <div class="sf-kpi-label">이번 달 예상 구독료</div>
            <div class="sf-kpi-value" id="statMonthlyExpense">{{#summary}}{{totalMonthlyExpenseFormatted}}{{/summary}}{{^summary}}0{{/summary}}<span>원</span></div>
            <div class="sf-kpi-meta">연간 환산 {{#summary}}{{totalYearlyExpenseFormatted}}{{/summary}}{{^summary}}0{{/summary}}원</div>
        </div>
        <div class="sf-kpi">
            <div class="sf-kpi-label">이용 중인 구독</div>
            <div class="sf-kpi-value" id="statActiveCount">{{#summary}}{{activeCount}}{{/summary}}{{^summary}}0{{/summary}}<span>개</span></div>
            <div class="sf-kpi-meta">정상 자동 갱신 중</div>
        </div>
        <div class="sf-kpi">
            <div class="sf-kpi-label">7일 이내 결제</div>
            <div class="sf-kpi-value" id="statUpcomingCount">{{#summary}}{{upcomingCountWithin7Days}}{{/summary}}{{^summary}}0{{/summary}}<span>건</span></div>
            <div class="sf-kpi-meta">결제일이 곧 도래합니다</div>
        </div>
    </section>

    <div class="tab-content" id="viewTabContent">

        <!-- 1. 캘린더 -->
        <div class="tab-pane fade show active" id="tab-calendar" role="tabpanel" aria-labelledby="tab-cal-btn">
            <div class="sf-cal-layout">
                <section class="sf-calendar">
                    <div class="sf-cal-head">
                        <h2 class="sf-cal-title" id="calCurrentTitle">2026년 11월</h2>
                        <div class="sf-cal-nav">
                            <button type="button" data-action="change-month" data-delta="-1" aria-label="이전 달">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button type="button" data-action="current-month">오늘</button>
                            <button type="button" data-action="change-month" data-delta="1" aria-label="다음 달">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>

                    <table class="calendar-table">
                        <thead>
                        <tr>
                            <th>일</th>
                            <th>월</th>
                            <th>화</th>
                            <th>수</th>
                            <th>목</th>
                            <th>금</th>
                            <th>토</th>
                        </tr>
                        </thead>
                        <tbody id="calendarGridBody">
                        <!-- JS 동적 캘린더 생성 -->
                        </tbody>
                    </table>
                </section>

                <aside class="sf-month">
                    <div class="sf-month-head">
                        <h3>이번 달 결제</h3>
                        <span id="monthTotal">0원</span>
                    </div>
                    <div id="monthPayments" class="sf-month-list">
                        <div class="sf-empty-line">불러오는 중…</div>
                    </div>
                </aside>
            </div>
        </div>

        <!-- 2. 구독 목록 -->
        <div class="tab-pane fade" id="tab-list" role="tabpanel" aria-labelledby="tab-list-btn">
            <section class="sf-list-panel">
                <div class="sf-list-head">
                    <h2 class="sf-list-title">구독</h2>
                    <span class="sf-count">총 {{subscriptionCount}}건</span>
                </div>

                <div class="sf-sub-list" id="subscriptionList">
                    {{#subscriptions}}
                    <article class="sf-sub-item">
                        <span class="sf-avatar" aria-hidden="true">{{#logoSlug}}{{#logoImage}}<img class="sf-brand-img" src="/logos/{{logoSlug}}.png" alt="">{{/logoImage}}{{^logoImage}}<span class="sf-brand-logo" style="--brand-logo: url('/logos/{{logoSlug}}.svg'); --brand-color: {{logoColor}};"></span>{{/logoImage}}{{/logoSlug}}{{^logoSlug}}{{initial}}{{/logoSlug}}</span>
                        <div class="sf-sub-main">
                            <div class="sf-sub-name" title="{{serviceName}}">{{serviceName}}</div>
                            <div class="sf-sub-memo">{{categoryDescription}} · {{billingCycleDescription}}{{#memo}} · {{memo}}{{/memo}}</div>
                        </div>
                        <div class="sf-sub-amount">
                            <div class="sf-amount">{{monthlyExpenseFormatted}}<span>원</span></div>
                            <div class="sf-sub-date">{{nextBillingDate}} · {{dDayLabel}}</div>
                        </div>
                        <div class="sf-sub-actions">
                            <span class="sf-status" data-status="{{status}}">{{statusDescription}}</span>
                            <div class="dropdown">
                                <button type="button" class="sf-icon-btn" data-bs-toggle="dropdown"
                                        aria-expanded="false" aria-label="{{serviceName}} 관리 메뉴">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end sf-dropdown">
                                    <li>
                                        <button type="button" class="dropdown-item" data-id="{{id}}"
                                                data-name="{{serviceName}}" data-action="open-share">함께 쓰기</button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item" data-name="{{serviceName}}"
                                                data-action="open-cancel-guide">해지 방법</button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item" data-id="{{id}}"
                                                data-name="{{serviceName}}" data-action="cancel-subscription">해지</button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item text-danger" data-id="{{id}}"
                                                data-action="delete-subscription">삭제</button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </article>
                    {{/subscriptions}}
                    {{^subscriptions}}
                    <div class="sf-empty">
                        <i class="bi bi-inbox"></i>
                        <p>등록된 구독이 없습니다. 오른쪽 위의 <strong>새 구독</strong> 버튼으로 추가해보세요.</p>
                    </div>
                    {{/subscriptions}}
                </div>
            </section>
        </div>

        <!-- 3. 지출 분석 -->
        <div class="tab-pane fade" id="tab-charts" role="tabpanel" aria-labelledby="tab-charts-btn">
            <div class="sf-insight-grid">
                <section class="sf-insight-panel">
                    <h2 class="sf-list-title">절약 제안</h2>
                    <p class="sf-insight-total" id="insightSavingTotal">-</p>
                    <div class="sf-insight-list" id="insightSavings">
                        <div class="sf-empty-line">불러오는 중…</div>
                    </div>
                </section>
                <section class="sf-insight-panel">
                    <h2 class="sf-list-title">중복 구독</h2>
                    <p class="sf-insight-total" id="insightDuplicateTotal">-</p>
                    <div class="sf-insight-list" id="insightDuplicates">
                        <div class="sf-empty-line">불러오는 중…</div>
                    </div>
                </section>
            </div>

            <section class="sf-insight-panel sf-benefit-panel">
                <h2 class="sf-list-title">내 혜택</h2>
                <p class="sf-insight-total" id="insightBenefitTotal">-</p>
                <div class="sf-insight-list" id="insightBenefits">
                    <div class="sf-empty-line">불러오는 중…</div>
                </div>
            </section>

            <div class="sf-chart-grid">
                <section class="sf-chart-panel">
                    <h2 class="sf-list-title">카테고리별 지출</h2>
                    <div class="sf-chart-box">
                        <div class="sf-donut-wrap">
                            <canvas id="categoryDonutChart"></canvas>
                            <div class="sf-donut-center">
                                <span>월 환산</span>
                                <strong id="donutTotal">-</strong>
                                <span>원</span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="sf-chart-panel">
                    <h2 class="sf-list-title">서비스별 월 지출</h2>
                    <div class="sf-chart-box">
                        <canvas id="servicesBarChart"></canvas>
                    </div>
                </section>
            </div>

            {{#localProfile}}
            <section class="sf-demo-tools">
                <div class="sf-demo-head">
                    <span>배치 도구</span>
                    <div class="sf-demo-buttons">
                        <button type="button" class="sf-demo-btn" data-action="run-batch" data-batch="run-billing-batch">결제 갱신</button>
                        <button type="button" class="sf-demo-btn" data-action="run-batch" data-batch="run-notification-batch">알림 발송</button>
                        <button type="button" class="sf-demo-btn" data-action="run-batch" data-batch="run-expiration-batch">만료 처리</button>
                    </div>
                </div>
                <div id="logsContainer" class="sf-log-list">
                    <div class="sf-empty-line">배치를 실행하면 알림과 결제 기록이 표시됩니다.</div>
                </div>
            </section>
            {{/localProfile}}
        </div>

        <!-- 4. 공유받은 구독 -->
        <div class="tab-pane fade" id="tab-shares" role="tabpanel" aria-labelledby="tab-shares-btn">
            <div class="sf-insight-grid">
                <section class="sf-insight-panel">
                    <h2 class="sf-list-title">초대 받은 구독</h2>
                    <div class="sf-insight-list" id="shareInvitations">
                        <div class="sf-empty-line">불러오는 중…</div>
                    </div>
                </section>
                <section class="sf-insight-panel">
                    <h2 class="sf-list-title">참여 중인 구독</h2>
                    <div class="sf-insight-list" id="shareActive">
                        <div class="sf-empty-line">불러오는 중…</div>
                    </div>
                </section>
            </div>
        </div>

    </div>
</main>

<!-- 새 구독 등록 모달 -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="createModalTitle"><i class="bi bi-plus-circle text-primary"></i>새 구독 추가</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
            </div>
            <div class="modal-body">
                <div id="stepService">
                    <p class="sf-step-desc">구독 중인 서비스를 선택하세요. 요금제와 금액이 자동으로 채워집니다.</p>
                    <div class="sf-service-search-row">
                        <div class="sf-service-search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search" id="serviceSearch" placeholder="서비스 검색" aria-label="서비스 검색" autocomplete="off">
                        </div>
                        <button type="button" class="sf-direct-link" data-action="select-direct">
                            <i class="bi bi-plus-lg"></i> 직접 입력
                        </button>
                    </div>
                    <div class="sf-service-filters" id="serviceFilters" role="group" aria-label="카테고리 필터"></div>
                    <div class="sf-service-grid" id="serviceGrid"></div>
                </div>

                <div id="stepDetails" class="d-none">
                    <button type="button" class="sf-back-btn" data-action="show-service-step">
                        <i class="bi bi-arrow-left"></i> 서비스 다시 선택
                    </button>
                    <div class="sf-selected-service" id="selectedService"></div>

                    <div class="mb-3 d-none" id="planSection">
                        <div class="sf-plan-label">요금제</div>
                        <div class="sf-plan-grid" id="planOptions" role="radiogroup" aria-label="요금제 선택"></div>
                    </div>

                    <form id="createForm">
                        <div class="mb-3">
                            <label class="form-label" for="serviceName">서비스명 <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="serviceName" placeholder="예: 넷플릭스 프리미엄" required>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="category">카테고리</label>
                                <select class="form-select" id="category">
                                    {{#categories}}
                                    <option value="{{.}}">{{description}}</option>
                                    {{/categories}}
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="billingCycle">결제 주기 <span class="text-danger">*</span></label>
                                <select class="form-select" id="billingCycle">
                                    <option value="MONTHLY">매월 결제</option>
                                    <option value="YEARLY">매년 결제</option>
                                    <option value="WEEKLY">매주 결제</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="fee">결제 금액 (원) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="fee" placeholder="17000" min="0" required>
                            </div>
                            <div class="col-6" id="billingDayContainer">
                                <label class="form-label" for="billingDay">매월 결제일</label>
                                <input type="number" class="form-control" id="billingDay" placeholder="25" min="1" max="31">
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="startDate">구독 시작일</label>
                                <input type="date" class="form-control" id="startDate">
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="remindDaysBefore">결제 예정 알림</label>
                                <select class="form-select" id="remindDaysBefore">
                                    <option value="1">1일 전</option>
                                    <option value="3" selected>3일 전</option>
                                    <option value="7">7일 전</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="memo">메모</label>
                            <input type="text" class="form-control" id="memo" placeholder="예: 친구 3명과 파티 계정">
                        </div>

                        <div class="preview-box" id="previewBox">
                            <div class="preview-head"><i class="bi bi-stars"></i>실시간 자동 계산</div>
                            <div class="preview-grid">
                                <div>
                                    <span class="preview-label">다음 결제일</span>
                                    <strong id="previewNextBilling">-</strong>
                                    <span class="sf-dday" id="previewDDay"></span>
                                </div>
                                <div>
                                    <span class="preview-label">월 환산 예상 지출</span>
                                    <strong class="preview-amount" id="previewMonthlyExpense">-</strong>
                                    <span class="text-muted">원</span>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                <button type="button" class="btn btn-primary d-none" id="createSubmitBtn" data-action="submit-subscription">
                    <i class="bi bi-check-lg me-1"></i>구독 등록
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 구독 해지 모달 -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="cancelModalTitle"><i class="bi bi-x-circle text-warning"></i>구독 해지</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3"><strong id="cancelServiceName"></strong> 구독을 해지합니다.</p>
                <input type="hidden" id="cancelSubscriptionId">

                <div class="sf-radio-stack mb-3">
                    <label class="sf-radio-card" for="cancelModeImmediate">
                        <input class="form-check-input" type="radio" name="cancelMode" id="cancelModeImmediate"
                               value="immediate" checked>
                        <span>
                            <strong>즉시 해지</strong>
                            <small>지금 바로 구독을 종료합니다.</small>
                        </span>
                    </label>
                    <label class="sf-radio-card" for="cancelModeScheduled">
                        <input class="form-check-input" type="radio" name="cancelMode" id="cancelModeScheduled"
                               value="scheduled">
                        <span>
                            <strong>해지 예약</strong>
                            <small>선택한 날짜에 자동으로 해지됩니다.</small>
                        </span>
                    </label>
                </div>

                <div id="cancelDateGroup" class="mb-2 d-none">
                    <label class="form-label" for="cancelDate">해지 예정일</label>
                    <input type="date" class="form-control" id="cancelDate">
                </div>

                <div class="sf-error d-none" id="cancelError" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                <button type="button" class="btn btn-warning" id="cancelSubmitBtn" data-action="submit-cancel">해지하기</button>
            </div>
        </div>
    </div>
</div>
<!-- 내역 가져오기 모달 -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="importModalTitle">내역 가져오기</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
            </div>
            <div class="modal-body">
                <div id="importStep1">
                    <div class="sf-import-drop" id="importDropZone" role="button" tabindex="0"
                         data-action="pick-import-file">
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                        <strong>CSV 또는 엑셀(XLSX) 파일을 선택하거나 여기로 끌어다 놓으세요</strong>
                        <small>카드/은행 앱에서 내려받은 내역 파일 · 최대 5MB, 5,000건</small>
                        <span id="importFileName" class="sf-import-filename d-none"></span>
                    </div>
                    <input type="file" id="importFileInput" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="d-none">
                </div>

                <div id="importStep2" class="d-none">
                    <div id="importMapping" class="d-none">
                        <p class="sf-import-hint">컬럼을 자동으로 찾지 못했습니다. 직접 선택해 주세요.</p>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label" for="mapDate">날짜</label>
                                <select class="form-select form-select-sm" id="mapDate"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="mapMerchant">가맹점</label>
                                <select class="form-select form-select-sm" id="mapMerchant"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="mapAmount">금액</label>
                                <select class="form-select form-select-sm" id="mapAmount"></select>
                            </div>
                        </div>
                        <button type="button" class="sf-btn sf-btn-primary mt-3" data-action="preview-import-manual">다시 분석</button>
                    </div>

                    <div id="importPreviewBody">
                        <div class="sf-import-summary" id="importSummary"></div>
                        <div class="sf-import-table">
                            <table class="table align-middle">
                                <thead>
                                <tr>
                                    <th><input type="checkbox" class="form-check-input" id="importSelectAll"
                                               aria-label="전체 선택"></th>
                                    <th>날짜</th>
                                    <th>가맹점</th>
                                    <th class="text-end">금액</th>
                                    <th>매칭</th>
                                    <th>신뢰도</th>
                                </tr>
                                </thead>
                                <tbody id="importRows"></tbody>
                            </table>
                        </div>
                        <div id="importCandidates"></div>
                        <div id="importSkipped" class="sf-import-skipped d-none"></div>
                    </div>
                </div>

                <div id="importStep3" class="d-none">
                    <div class="sf-import-result">
                        <i class="bi bi-check-circle"></i>
                        <h3 id="importResultTitle">가져오기 완료</h3>
                        <p id="importResultText"></p>
                    </div>
                </div>

                <div class="sf-error d-none mt-3" id="importError" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">닫기</button>
                <button type="button" class="sf-btn sf-btn-primary" id="importPreviewBtn" data-action="preview-import" disabled>다음</button>
                <button type="button" class="sf-btn sf-btn-primary d-none" id="importConfirmBtn" data-action="confirm-import">적용</button>
            </div>
        </div>
    </div>
</div>


<!-- 함께 쓰기 모달 -->
<div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="shareModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="shareModalTitle">함께 쓰기</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
            </div>
            <div class="modal-body">
                <p class="sf-guide-service" id="shareServiceName"></p>

                <div class="sf-share-summary">
                    <div>
                        <span>이번 달 받은 금액</span>
                        <strong id="shareReceived">0원</strong>
                    </div>
                    <div>
                        <span>남은 금액</span>
                        <strong id="sharePending">0원</strong>
                    </div>
                </div>

                <div id="shareList" class="sf-share-list">
                    <div class="sf-empty-line">불러오는 중…</div>
                </div>

                <form id="shareForm" class="sf-share-form">
                    <input type="text" class="form-control" id="shareMemberName" placeholder="멤버 이름" maxlength="50">
                    <input type="number" class="form-control" id="shareAmount" placeholder="분담 금액" min="1">
                    <input type="email" class="form-control" id="shareMemberEmail" placeholder="이메일 (선택)">
                    <button type="submit" class="sf-btn sf-btn-primary">추가</button>
                </form>
                <div class="sf-error d-none" id="shareError" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">닫기</button>
            </div>
        </div>
    </div>
</div>

<!-- 해지 방법 모달 -->
<div class="modal fade" id="cancelGuideModal" tabindex="-1" aria-labelledby="cancelGuideTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="cancelGuideTitle">해지 방법</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
            </div>
            <div class="modal-body">
                <p class="sf-guide-service" id="cancelGuideService"></p>
                <div id="cancelGuideBody"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">닫기</button>
            </div>
        </div>
    </div>
</div>

