<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>SubFlow - 구독 관리 대시보드</title>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/app.css?v=20261124n">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
</head>
<body>

<h1 class="visually-hidden">SubFlow 구독 통합 관리</h1>

<!-- 토스트 알림 -->
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="liveToast" class="toast align-items-center text-bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">알림 내용</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="알림 닫기"></button>
        </div>
    </div>
</div>

<div class="sf-shell">

    <!-- 사이드바 -->
    <aside class="sf-sidebar">
        <a class="sf-brand" href="/">
            <span class="sf-brand-mark"><i class="bi bi-wallet2"></i></span>
            <span>SubFlow</span>
        </a>

        <nav class="sf-nav nav" id="viewTabs" role="tablist" aria-label="화면 전환">
            <button class="sf-nav-link nav-link active" id="tab-list-btn" type="button" role="tab"
                    data-bs-toggle="pill" data-bs-target="#tab-list" aria-controls="tab-list" aria-selected="true">
                <i class="bi bi-grid-1x2"></i>구독 목록
            </button>
            <button class="sf-nav-link nav-link" id="tab-cal-btn" type="button" role="tab"
                    data-bs-toggle="pill" data-bs-target="#tab-calendar" aria-controls="tab-calendar" aria-selected="false"
                    onclick="loadCalendar()">
                <i class="bi bi-calendar3"></i>결제 캘린더
            </button>
            <button class="sf-nav-link nav-link" id="tab-charts-btn" type="button" role="tab"
                    data-bs-toggle="pill" data-bs-target="#tab-charts" aria-controls="tab-charts" aria-selected="false"
                    onclick="renderCharts()">
                <i class="bi bi-pie-chart"></i>지출 분석
            </button>
        </nav>

        <div class="sf-sidebar-footer">
            <div class="sf-demo">
                <div class="sf-demo-title"><i class="bi bi-cpu"></i> 데모 도구</div>
                <div class="sf-demo-buttons">
                    <button type="button" class="sf-demo-btn" onclick="triggerBatch('run-billing-batch')" title="오늘자 결제 완료 및 다음 결제일 갱신">결제 갱신</button>
                    <button type="button" class="sf-demo-btn" onclick="triggerBatch('run-notification-batch')" title="D-3 결제 예정 알림 생성">알림 발송</button>
                    <button type="button" class="sf-demo-btn" onclick="triggerBatch('run-expiration-batch')" title="해지 예정 건 자동 해지">만료 처리</button>
                </div>
                <div class="sf-demo-note">배치 작업을 즉시 실행합니다</div>
            </div>
        </div>
    </aside>

    <!-- 본문 -->
    <div class="sf-main">
        <header class="sf-topbar">
            <div>
                <div class="sf-eyebrow">SUBSCRIPTION OVERVIEW</div>
                <h2 class="sf-page-title">구독 대시보드</h2>
            </div>
            <div class="sf-topbar-actions">
                <span class="sf-today" id="todayLabel"></span>
                <button type="button" class="sf-btn sf-btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
                    <i class="bi bi-plus-lg"></i>새 구독
                </button>
            </div>
        </header>

        <main class="sf-content">

            <!-- 요약 지표 -->
            <section class="sf-kpis" aria-label="구독 요약">
                <div class="sf-kpi">
                    <div class="sf-kpi-top">
                        <span>이번 달 예상 구독료</span>
                        <span class="sf-kpi-icon"><i class="bi bi-wallet2"></i></span>
                    </div>
                    <div class="sf-kpi-value" id="statMonthlyExpense">
                        {{#summary}}{{totalMonthlyExpenseFormatted}}{{/summary}}{{^summary}}0{{/summary}}<span> 원</span>
                    </div>
                    <div class="sf-kpi-meta">연간 환산 {{#summary}}{{totalYearlyExpenseFormatted}}{{/summary}}{{^summary}}0{{/summary}}원</div>
                </div>

                <div class="sf-kpi">
                    <div class="sf-kpi-top">
                        <span>이용 중인 구독</span>
                        <span class="sf-kpi-icon is-success"><i class="bi bi-check2-circle"></i></span>
                    </div>
                    <div class="sf-kpi-value" id="statActiveCount">
                        {{#summary}}{{activeCount}}{{/summary}}{{^summary}}0{{/summary}}<span> 개</span>
                    </div>
                    <div class="sf-kpi-meta">정상 자동 갱신 중</div>
                </div>

                <div class="sf-kpi">
                    <div class="sf-kpi-top">
                        <span>7일 이내 결제</span>
                        <span class="sf-kpi-icon is-warning"><i class="bi bi-alarm"></i></span>
                    </div>
                    <div class="sf-kpi-value" id="statUpcomingCount">
                        {{#summary}}{{upcomingCountWithin7Days}}{{/summary}}{{^summary}}0{{/summary}}<span> 건</span>
                    </div>
                    <div class="sf-kpi-meta">결제일이 곧 도래합니다</div>
                </div>
            </section>

            <div class="tab-content" id="viewTabContent">

                <!-- 1. 구독 목록 -->
                <div class="tab-pane fade show active" id="tab-list" role="tabpanel" aria-labelledby="tab-list-btn">
                    <div class="sf-grid">
                        <section class="sf-panel">
                            <div class="sf-panel-head">
                                <h3 class="sf-panel-title"><i class="bi bi-collection"></i>내 구독 서비스</h3>
                                <span class="sf-count">총 {{#summary}}{{activeCount}}{{/summary}}{{^summary}}0{{/summary}}건</span>
                            </div>
                            <div class="sf-panel-body">
                                <div class="sf-sub-list" id="subscriptionList">
                                    {{#subscriptions}}
                                    <article class="sf-sub-item">
                                        <span class="sf-avatar" style="background-color: {{categoryColor}}1f;" aria-hidden="true">{{#logoSlug}}<span class="sf-brand-logo" style="--brand-logo: url('/logos/{{logoSlug}}.svg'); --brand-color: {{logoColor}};"></span>{{/logoSlug}}{{^logoSlug}}{{initial}}{{/logoSlug}}</span>
                                        <div class="sf-sub-main">
                                            <div class="sf-sub-name" title="{{serviceName}}">{{serviceName}}</div>
                                            {{#memo}}<div class="sf-sub-memo" title="{{memo}}">{{memo}}</div>{{/memo}}
                                        </div>
                                        <div class="sf-sub-meta">
                                            <span class="sf-chip">{{categoryDescription}}</span>
                                            <span class="sf-chip">{{billingCycleDescription}}</span>
                                        </div>
                                        <div class="sf-sub-amount">
                                            <div class="sf-amount">{{monthlyExpenseFormatted}}<span>원</span></div>
                                            <div class="sf-sub-date">{{nextBillingDate}}<span class="sf-dday">D-{{dDay}}</span></div>
                                        </div>
                                        <div class="sf-sub-actions">
                                            <span class="sf-status" data-status="{{status}}">{{statusDescription}}</span>
                                            <div class="dropdown">
                                                <button type="button" class="sf-icon-btn" data-bs-toggle="dropdown"
                                                        aria-expanded="false" aria-label="{{serviceName}} 관리 메뉴">
                                                    <i class="bi bi-three-dots"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end sf-dropdown">
                                                    <li>
                                                        <button type="button" class="dropdown-item" data-id="{{id}}"
                                                                data-name="{{serviceName}}" onclick="cancelModal(this)">해지</button>
                                                    </li>
                                                    <li>
                                                        <button type="button" class="dropdown-item text-danger" data-id="{{id}}"
                                                                onclick="deleteSubscription(this)">삭제</button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </article>
                                    {{/subscriptions}}
                                    {{^subscriptions}}
                                    <div class="sf-empty">
                                        <i class="bi bi-inbox"></i>
                                        <p>등록된 구독 서비스가 없습니다.<br>오른쪽 위의 <strong>새 구독</strong> 버튼으로 추가해보세요.</p>
                                    </div>
                                    {{/subscriptions}}
                                </div>
                            </div>
                        </section>

                        <aside class="sf-side">
                            <section class="sf-panel">
                                <div class="sf-panel-head">
                                    <h3 class="sf-panel-title"><i class="bi bi-pie-chart"></i>카테고리 지출</h3>
                                    <span class="sf-count">월 환산</span>
                                </div>
                                <div class="sf-panel-body">
                                    <div class="sf-cat-list">
                                        {{#summary.categoryExpenses}}
                                        <div class="sf-cat-row">
                                            <div class="sf-cat-head">
                                                <span class="sf-cat-name">
                                                    <span class="sf-cat-dot" style="background-color: {{color}};"></span>
                                                    {{categoryDescription}} <span class="text-muted">{{count}}건</span>
                                                </span>
                                                <span class="sf-cat-amount">{{amountFormatted}}원 <span>({{percentage}}%)</span></span>
                                            </div>
                                            <div class="sf-cat-track">
                                                <div class="sf-cat-fill" style="width: {{percentage}}%; background-color: {{color}};"></div>
                                            </div>
                                        </div>
                                        {{/summary.categoryExpenses}}
                                        {{^summary.categoryExpenses}}
                                        <div class="sf-empty is-compact">
                                            <i class="bi bi-bar-chart"></i>
                                            <p>집계된 카테고리 데이터가 없습니다.</p>
                                        </div>
                                        {{/summary.categoryExpenses}}
                                    </div>
                                </div>
                            </section>

                            <section class="sf-panel">
                                <div class="sf-panel-head">
                                    <h3 class="sf-panel-title"><i class="bi bi-clock-history"></i>최근 활동</h3>
                                </div>
                                <div class="sf-panel-body" style="max-height: 320px; overflow-y: auto;">
                                    <div id="logsContainer">
                                        <div class="sf-empty is-compact">
                                            <i class="bi bi-bell"></i>
                                            <p>배치를 실행하면 알림과 결제 기록이 표시됩니다.</p>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </aside>
                    </div>
                </div>

                <!-- 2. 결제 캘린더 -->
                <div class="tab-pane fade" id="tab-calendar" role="tabpanel" aria-labelledby="tab-cal-btn">
                    <section class="sf-panel">
                        <div class="sf-panel-head sf-calendar-toolbar">
                            <div class="sf-calendar-toolbar-title">
                                <h3 class="sf-panel-title"><i class="bi bi-calendar3"></i>결제 일정</h3>
                                <span class="sf-calendar-month" id="calCurrentTitle">2026년 11월</span>
                            </div>
                            <div class="sf-segmented" role="group" aria-label="월 이동">
                                <button type="button" class="sf-seg-btn" onclick="changeMonth(-1)" aria-label="이전 달">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <button type="button" class="sf-seg-btn" onclick="goToCurrentMonth()">오늘</button>
                                <button type="button" class="sf-seg-btn" onclick="changeMonth(1)" aria-label="다음 달">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>

                        <div class="sf-calendar-legend" id="calLegend">
                            {{#categories}}
                            <span class="sf-legend-item">
                                <span class="sf-legend-dot" style="background-color: {{color}};"></span>{{description}}
                            </span>
                            {{/categories}}
                        </div>

                        <div class="table-responsive sf-calendar-scroll">
                            <table class="calendar-table">
                                <thead>
                                <tr>
                                    <th>일</th>
                                    <th>월</th>
                                    <th>화</th>
                                    <th>수</th>
                                    <th>목</th>
                                    <th>금</th>
                                    <th>토</th>
                                </tr>
                                </thead>
                                <tbody id="calendarGridBody">
                                <!-- JS 동적 캘린더 생성 -->
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>

                <!-- 3. 지출 분석 -->
                <div class="tab-pane fade" id="tab-charts" role="tabpanel" aria-labelledby="tab-charts-btn">
                    <div class="sf-chart-grid">
                        <section class="sf-panel">
                            <div class="sf-panel-head">
                                <h3 class="sf-panel-title"><i class="bi bi-pie-chart"></i>카테고리별 지출 비율</h3>
                            </div>
                            <div class="sf-panel-body">
                                <div class="sf-chart-box">
                                    <div class="sf-donut-wrap">
                                        <canvas id="categoryDonutChart"></canvas>
                                        <div class="sf-donut-center">
                                            <span>월 환산</span>
                                            <strong id="donutTotal">-</strong>
                                            <span>원</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="sf-panel">
                            <div class="sf-panel-head">
                                <h3 class="sf-panel-title"><i class="bi bi-bar-chart"></i>서비스별 월 지출</h3>
                            </div>
                            <div class="sf-panel-body">
                                <div class="sf-chart-box">
                                    <canvas id="servicesBarChart"></canvas>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

            </div>
        </main>
    </div>
</div>

<!-- 새 구독 등록 모달 -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="createModalTitle"><i class="bi bi-plus-circle text-primary"></i>새 구독 추가</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
            </div>
            <div class="modal-body">
                <div id="stepService">
                    <p class="sf-step-desc">구독 중인 서비스를 선택하세요. 요금제와 금액이 자동으로 채워집니다.</p>
                    <div class="sf-service-search-row">
                        <div class="sf-service-search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search" id="serviceSearch" placeholder="서비스 검색" aria-label="서비스 검색" autocomplete="off">
                        </div>
                        <button type="button" class="sf-direct-link" onclick="selectDirectEntry()">
                            <i class="bi bi-plus-lg"></i> 직접 입력
                        </button>
                    </div>
                    <div class="sf-service-filters" id="serviceFilters" role="group" aria-label="카테고리 필터"></div>
                    <div class="sf-service-grid" id="serviceGrid"></div>
                </div>

                <div id="stepDetails" class="d-none">
                    <button type="button" class="sf-back-btn" onclick="showServiceStep()">
                        <i class="bi bi-arrow-left"></i> 서비스 다시 선택
                    </button>
                    <div class="sf-selected-service" id="selectedService"></div>

                    <div class="mb-3 d-none" id="planSection">
                        <div class="sf-plan-label">요금제</div>
                        <div class="sf-plan-grid" id="planOptions" role="radiogroup" aria-label="요금제 선택"></div>
                    </div>

                    <form id="createForm">
                        <div class="mb-3">
                            <label class="form-label" for="serviceName">서비스명 <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="serviceName" placeholder="예: 넷플릭스 프리미엄" required>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="category">카테고리</label>
                                <select class="form-select" id="category">
                                    {{#categories}}
                                    <option value="{{.}}">{{description}}</option>
                                    {{/categories}}
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="billingCycle">결제 주기 <span class="text-danger">*</span></label>
                                <select class="form-select" id="billingCycle" onchange="updatePreview()">
                                    <option value="MONTHLY">매월 결제</option>
                                    <option value="YEARLY">매년 결제</option>
                                    <option value="WEEKLY">매주 결제</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="fee">결제 금액 (원) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="fee" placeholder="17000" min="0" oninput="updatePreview()" required>
                            </div>
                            <div class="col-6" id="billingDayContainer">
                                <label class="form-label" for="billingDay">매월 결제일</label>
                                <input type="number" class="form-control" id="billingDay" placeholder="25" min="1" max="31" oninput="updatePreview()">
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="startDate">구독 시작일</label>
                                <input type="date" class="form-control" id="startDate" onchange="updatePreview()">
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="remindDaysBefore">결제 예정 알림</label>
                                <select class="form-select" id="remindDaysBefore">
                                    <option value="1">1일 전</option>
                                    <option value="3" selected>3일 전</option>
                                    <option value="7">7일 전</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="memo">메모</label>
                            <input type="text" class="form-control" id="memo" placeholder="예: 친구 3명과 파티 계정">
                        </div>

                        <div class="preview-box" id="previewBox">
                            <div class="preview-head"><i class="bi bi-stars"></i>실시간 자동 계산</div>
                            <div class="preview-grid">
                                <div>
                                    <span class="preview-label">다음 결제일</span>
                                    <strong id="previewNextBilling">-</strong>
                                    <span class="sf-dday" id="previewDDay"></span>
                                </div>
                                <div>
                                    <span class="preview-label">월 환산 예상 지출</span>
                                    <strong class="preview-amount" id="previewMonthlyExpense">-</strong>
                                    <span class="text-muted">원</span>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                <button type="button" class="btn btn-primary d-none" id="createSubmitBtn" onclick="submitSubscription()">
                    <i class="bi bi-check-lg me-1"></i>구독 등록
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 구독 해지 모달 -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="cancelModalTitle"><i class="bi bi-x-circle text-warning"></i>구독 해지</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3"><strong id="cancelServiceName"></strong> 구독을 해지합니다.</p>
                <input type="hidden" id="cancelSubscriptionId">

                <div class="sf-radio-stack mb-3">
                    <label class="sf-radio-card" for="cancelModeImmediate">
                        <input class="form-check-input" type="radio" name="cancelMode" id="cancelModeImmediate"
                               value="immediate" checked onchange="syncCancelMode()">
                        <span>
                            <strong>즉시 해지</strong>
                            <small>지금 바로 구독을 종료합니다.</small>
                        </span>
                    </label>
                    <label class="sf-radio-card" for="cancelModeScheduled">
                        <input class="form-check-input" type="radio" name="cancelMode" id="cancelModeScheduled"
                               value="scheduled" onchange="syncCancelMode()">
                        <span>
                            <strong>해지 예약</strong>
                            <small>선택한 날짜에 자동으로 해지됩니다.</small>
                        </span>
                    </label>
                </div>

                <div id="cancelDateGroup" class="mb-2 d-none">
                    <label class="form-label" for="cancelDate">해지 예정일</label>
                    <input type="date" class="form-control" id="cancelDate">
                </div>

                <div class="sf-error d-none" id="cancelError" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                <button type="button" class="btn btn-warning" id="cancelSubmitBtn" onclick="submitCancel()">해지하기</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js?v=20261124n" defer></script>
</body>
</html>
